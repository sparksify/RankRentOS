# RankRent OS V2 — required environment variables (values live in Convex/Vercel
# dashboards, NEVER in source control; the V0 sibling-repo fallback is gone).
#
# Next.js (Vercel):
#   NEXT_PUBLIC_CONVEX_URL=   # Convex deployment URL (set after `convex dev` first run)
#   APP_PASSWORD=             # single-user login (UI phases)
#
# Convex (dashboard env vars, read only inside actions — Phase 2+):
#   SERPAPI_KEY=              # rotate the V0 key before use (it was shared)
#   DATAFORSEO_AUTH=          # rotate the V0 key before use
#   GOOGLE_PLACES_KEY=        # Phase 3
#   AI_PROVIDER=              # Phase 5: provider id, e.g. "anthropic" | "openai" (config-selected, not hardwired)
#   AI_API_KEY=               # Phase 5: key for the configured provider
